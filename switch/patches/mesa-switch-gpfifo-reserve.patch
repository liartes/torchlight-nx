+/* Entries that submit_locked appends after the pending batch: the completion
+ * tail plus the extra slot for its possible total-order wait.  Enqueue paths
+ * that do not submit themselves must keep them free, as exec_submit does;
+ * otherwise a nearly full GPFIFO accepts the batch and the next submit fails
+ * with NO_SPACE, which has no recovery path (the context reports device loss).
+ * Reporting NO_SPACE at enqueue time instead lets the caller submit the
+ * pending batch and retry.
+ */
+static uint32_t
+nouveau_horizon_channel_submit_tail_entries(
+   const struct nouveau_horizon_channel *channel)
+{
+   return (channel->mapped_completion_enabled ? 2 : 1) +
+          (channel->device->total_order_channels ? 1 : 0);
+}

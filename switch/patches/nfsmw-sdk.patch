+/*
+ * Deletes a folder and everything in it (torchlight, 2026-10-02). std::filesystem::remove_all lists the folder with
+ * std::filesystem, which lists folders wrongly on Horizon: on the console, deleting a character did nothing (the
+ * character stayed in the selection list). The listing goes through ListFiles (opendir/readdir, which work), and each
+ * entry is removed on its own (single std::filesystem::remove calls, no listing). Returns how many entries were
+ * removed, folder included; ec holds the first error.
+ */
+uint64_t BorrarCarpeta(const std::filesystem::path& carpeta, std::error_code& ec) {
+  ec.clear();
+  std::error_code e;
+  if (!std::filesystem::exists(carpeta, e)) {
+    return 0;
+  }
+  uint64_t borrados = 0;
+  for (const auto& f : rex::filesystem::ListFiles(carpeta)) {
+    const std::filesystem::path ruta = carpeta / f.name;
+    std::error_code e2;
+    if (f.type == rex::filesystem::FileInfo::Type::kDirectory || std::filesystem::is_directory(ruta, e2)) {
+      borrados += BorrarCarpeta(ruta, e2);
+    } else if (std::filesystem::remove(ruta, e2)) {
+      ++borrados;
+    }
+    if (e2 && !ec) {
+      ec = e2;
+    }
+  }
+  std::error_code e3;
+  if (std::filesystem::remove(carpeta, e3)) {
+    ++borrados;
+  }
+  if (e3 && !ec) {
+    ec = e3;
+  }
+  return borrados;
+}

+// Queues the read-ahead of the blocks after `desde`. Called with g_cache_mutex held.
+void PedirAnticipo(uint32_t id, uint64_t desde, const std::filesystem::path& ruta) {
+  const int32_t n = REXCVAR_GET(nfsmw_io_cache_anticipa);
+  if (n <= 0 || g_cache_sin_memoria || g_anticipo_roto) {
+    return;
+  }
+  for (uint64_t k = desde; k < desde + static_cast<uint64_t>(n); ++k) {
+    const uint64_t clave = (static_cast<uint64_t>(id) << 32) | k;
+    if (g_cache.count(clave) || g_en_vuelo.count(clave)) {
+      continue;
+    }
+    bool en_cola = false;
+    for (const Anticipo& a : g_anticipos) {
+      if (a.id == id && a.bloque == k) {
+        en_cola = true;
+        break;
+      }
+    }
+    if (en_cola) {
+      continue;
+    }
+    if (g_anticipos.size() >= 16) {
+      g_anticipos.pop_front();  // the oldest requests are the least likely to still be useful
+    }
+    g_anticipos.push_back({id, k, ruta});
+  }

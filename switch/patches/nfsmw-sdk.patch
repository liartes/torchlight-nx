+      ImGui::SameLine();
+      ImGui::TextColored(ImVec4(0.95f, 0.8f, 0.3f, 1.0f), "%dG / %dG", earned, total);
+      ImGui::Separator();
+
+      const float footer = ImGui::GetFrameHeightWithSpacing() + ImGui::GetStyle().ItemSpacing.y;

+// Torchlight : la Switch refuse de renommer un fichier encore ouvert, ce que les jeux Xbox font (renommage par
+// NtSetInformationFile sur le handle ouvert : Torchlight écrit save.tmp puis le renomme en 0.tsv). Repli : copie du
+// contenu vers le nouveau nom (l'écriture est finie quand le jeu renomme), puis suppression de l'ancien si possible.
+static bool CopyInsteadOfRename(const std::filesystem::path& from, const std::filesystem::path& to) {
+  std::error_code ec;
+  if (std::filesystem::is_directory(from, ec)) return false;
+  FILE* in = std::fopen(rex::path_to_utf8(from).c_str(), "rb");
+  if (!in) return false;
+  FILE* out = std::fopen(rex::path_to_utf8(to).c_str(), "wb");
+  if (!out) {
+    std::fclose(in);
+    return false;
+  }
+  char buf[65536];
+  size_t n;
+  bool ok = true;
+  while ((n = std::fread(buf, 1, sizeof(buf), in)) > 0) ok = ok && std::fwrite(buf, 1, n, out) == n;
+  ok = ok && !std::ferror(in);
+  std::fclose(in);
+  ok = std::fclose(out) == 0 && ok;
+  if (!ok) {
+    std::remove(rex::path_to_utf8(to).c_str());
+    return false;
+  }
+  std::remove(rex::path_to_utf8(from).c_str());  // échoue si encore ouvert : sans conséquence
+  REXFS_WARN("RenameEntryInternal: '{}' copié vers '{}' (renommage refusé, fichier ouvert ?)",
+             rex::path_to_utf8(from), rex::path_to_utf8(to));
+  return true;
+}

+/*
+ * Kernel memory blocks (Torchlight). Every region of the address space with its own
+ * state, permission or attribute is one KMemoryBlock, and running out of them makes
+ * even a small commit fail with 0xCE01 (OutOfResource) while plenty of memory is free.
+ * They come from the process's own system resource when its NPDM declares one
+ * (SystemResourceSize: the overridden title's, since the homebrew runs in its
+ * process), otherwise from a pool shared with the system, which would explain why
+ * running out once hung the whole console. Walking the address space costs one
+ * svcQueryMemory per block, a few ms every 10 s.
+ */
+struct BloquesNucleo {
+  size_t total = 0;
+  size_t heap = 0;    // MemType_Heap: heap split by the backings mapped as code and by NvMap
+  size_t codigo = 0;  // MemType_ModuleCode*: shadows of the guest chunks
+  size_t vistas = 0;  // MemType_ProcessMem: guest views (svcMapProcessMemory)
+  size_t otros = 0;
+  u64 recurso_usado_kb = 0, recurso_total_kb = 0;
+};
+
+BloquesNucleo ContarBloques() {
+  BloquesNucleo b;
+  u64 addr = 0;
+  for (;;) {
+    MemoryInfo mi{};
+    u32 pi = 0;
+    if (R_FAILED(svcQueryMemory(&mi, &pi, addr))) break;
+    ++b.total;
+    switch (mi.type & MemState_Type) {
+      case MemType_Heap: ++b.heap; break;
+      case MemType_ModuleCodeStatic:
+      case MemType_ModuleCodeMutable: ++b.codigo; break;
+      case MemType_ProcessMem: ++b.vistas; break;
+      default: ++b.otros; break;
+    }
+    const u64 sig = mi.addr + mi.size;
+    if (sig <= addr) break;  // last block (unmapped up to the end of the space)
+    addr = sig;
+  }
+  u64 v = 0;
+  if (R_SUCCEEDED(svcGetInfo(&v, InfoType_SystemResourceSizeUsed, CUR_PROCESS_HANDLE, 0))) {
+    b.recurso_usado_kb = v >> 10;
+  }
+  if (R_SUCCEEDED(svcGetInfo(&v, InfoType_SystemResourceSizeTotal, CUR_PROCESS_HANDLE, 0))) {
+    b.recurso_total_kb = v >> 10;
+  }
+  return b;
+}

+/*
+ * Smallest commit (Torchlight): each chunk costs the kernel a code alias plus one
+ * mapping per view, and a game that commits its physical memory 4 KB at a time
+ * runs out of kernel memory blocks (0xCE01, OutOfResource) with only ~300 MB
+ * committed. Rounding commits to 64 KB divides the number of chunks by up to 16.
+ * The extra pages are committed zeroed, which the guest cannot tell apart.
+ *
+ * 64 KB was still not enough: Torchlight's physical heap hands out small blocks
+ * (8 to 160 KB) one after another, top down, and each one became its own chunk.
+ * On another console the game hit 0xCE01 again after a town -> mine -> town trip,
+ * with 1,135 chunks for 395 MB (left part of the town black, then the whole console
+ * hung: the kernel memory blocks may be shared with the system). Committing whole
+ * 2 MB blocks puts those neighbours in a single chunk (at most 256 for the 512 MB
+ * of the 360) and lets the kernel use block descriptors. The cost is at most 2 MB
+ * per committed run, and a chunk only partly decommitted stays committed, which
+ * the 512 MB of guest physical memory bounds.
+ */
+constexpr size_t kCommitGranule = kBlockSize;
 
 constexpr size_t AlignDown(size_t v, size_t a) { return v & ~(a - 1); }
 constexpr size_t AlignUp(size_t v, size_t a) { return (v + a - 1) & ~(a - 1); }
 
+/*
+ * Commit grid. Guest physical memory (mapping offsets 0x100000000 and up) is committed with a
+ * 4 KB phase: the 0xE0000000 view reaches it 4 KB further on, so a chunk that starts at
+ * 0x...1000 covers exactly one 2 MB block of that view, and the kernel can use a block
+ * descriptor there. The raw physical view is placed in the same phase (xmemory.cpp). Measured on
+ * the console (Torchlight): a TLB miss in that view cost 130 ns in 4 KB pages, as much as a RAM
+ * access, and it holds most of the game's physical memory.
+ */
+constexpr size_t kPhysicalBegin = 0x100000000;
+constexpr size_t kPhysicalEnd   = 0x120000000;
+constexpr size_t kPhysicalPhase = 0x1000;
+
+constexpr size_t GridDown(size_t v) {
+    if (v < kPhysicalBegin || v >= kPhysicalEnd) return AlignDown(v, kCommitGranule);
+    if (v < kPhysicalBegin + kPhysicalPhase) return kPhysicalBegin;
+    return AlignDown(v - kPhysicalPhase, kCommitGranule) + kPhysicalPhase;
+}
+
+constexpr size_t GridUp(size_t v) {
+    if (v <= kPhysicalBegin || v > kPhysicalEnd) return AlignUp(v, kCommitGranule);
+    if (v <= kPhysicalBegin + kPhysicalPhase) return kPhysicalBegin + kPhysicalPhase;
+    const size_t up = AlignUp(v - kPhysicalPhase, kCommitGranule) + kPhysicalPhase;
+    return up < kPhysicalEnd ? up : kPhysicalEnd;
